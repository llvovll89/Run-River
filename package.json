{
  "name": "run-river",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:env": "node scripts/validate-env.mjs",
    "verify:deploy": "npm run check:env && npm run build",
    "build": "next build && node scripts/generate-service-worker.mjs",
    "build:pwa": "npm run build",
    "test:unit": "node --import tsx --test tests/offline.test.ts",
    "test:offline": "node scripts/verify-offline.mjs",
    "start": "next start",
    "build:mobile": "node scripts/build-mobile.mjs",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/postcss": "^4.2.4",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "playwright": "1.65.0",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "@capacitor/cli": "8.6.2"
  }
}
